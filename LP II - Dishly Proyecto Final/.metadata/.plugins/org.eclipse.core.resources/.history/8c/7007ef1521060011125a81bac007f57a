package com.dishly.app.controller;

import com.dishly.app.model.Plato;
import com.dishly.app.service.CarritoService;
import com.dishly.app.service.PlatoService;
import jakarta.servlet.http.HttpSession;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.*;

@Controller
@RequestMapping("/cliente")
public class ClienteController {

    private final PlatoService platoService;
    private final CarritoService carritoService;

    public ClienteController(PlatoService platoService, CarritoService carritoService) {
        this.platoService = platoService;
        this.carritoService = carritoService;
    }

    @GetMapping("/carrito")
    public String carrito(HttpSession session, Model model) {
        model.addAttribute("items", carritoService.obtener(session));
        model.addAttribute("total", carritoService.total(session));
        return "cliente/carrito";
    }

    @GetMapping("/carrito/agregar/{id}")
    public String agregar(@PathVariable Long id, HttpSession session) {
        Plato plato = platoService.buscarPorId(id);
        carritoService.agregar(session, plato);
        return "redirect:/menu";
    }

    // DATOS PARA EL HEADER
    @ModelAttribute
    public void header(HttpSession session, Model model) {
        model.addAttribute("cartCount", carritoService.cantidad(session));
        model.addAttribute("cartTotal", carritoService.total(session));
    }
}