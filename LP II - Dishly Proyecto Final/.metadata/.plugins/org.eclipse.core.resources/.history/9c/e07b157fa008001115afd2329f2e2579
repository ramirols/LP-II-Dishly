<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layout/main}">
      
<main layout:fragment="content"layout:fragment="content">
<section>
    <h2 class="text-2xl font-bold mb-4">Carrito de compras</h2>

    <table class="w-full border">
        <tr class="bg-gray-100">
            <th>Plato</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
        </tr>

        <tr th:each="item : ${items}">
            <td th:text="${item.plato.nombre}"></td>
            <td th:text="${item.cantidad}"></td>
            <td>S/ <span th:text="${item.subtotal}"></span></td>
        </tr>
    </table>

    <div class="text-right mt-4">
        <p class="text-xl font-bold">
            Total: S/ <span th:text="${total}"></span>
        </p>

        <a th:href="@{/checkout}"
           class="inline-block mt-4 bg-green-600 text-white px-6 py-2 rounded">
            Continuar al pago
        </a>
    </div>
</section>
</main>

</html>