<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
	<div th:replace="~{layout/main :: layout(~{::body})}">
	  <section class="text-center py-24 bg-white">
	      <span class="inline-block bg-blue-100 text-blue-600 px-4 py-1 rounded-full text-sm mb-4">
	          🍽️ Restaurante digital
	      </span>

	      <h2 class="text-5xl font-bold mb-6">
	          Ordena fácil, rápido y sin colas
	      </h2>

	      <p class="text-gray-600 max-w-xl mx-auto mb-8">
	          Disly conecta tu antojo con los mejores platos del restaurante,
	          ya sea delivery o consumo en local.
	      </p>

	      <a th:href="@{/menu}"
	         class="bg-blue-600 text-white px-8 py-4 rounded-lg hover:bg-blue-700">
	          Ver menú
	      </a>
	  </section>

	  <section class="py-20 bg-gray-50">
	      <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
	          <div>
	              <h3 class="font-bold text-xl mb-2">🚀 Rápido</h3>
	              <p class="text-gray-600">Ordena en segundos desde cualquier dispositivo.</p>
	          </div>
	          <div>
	              <h3 class="font-bold text-xl mb-2">🔐 Seguro</h3>
	              <p class="text-gray-600">Pagos y datos protegidos.</p>
	          </div>
	          <div>
	              <h3 class="font-bold text-xl mb-2">📦 Flexible</h3>
	              <p class="text-gray-600">Delivery o consumo en local.</p>
	          </div>
	      </div>
	  </section>

	  <section class="py-20 bg-white">
	      <div class="container mx-auto text-center">
	          <h3 class="text-3xl font-bold mb-10">¿Cómo funciona?</h3>

	          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
	              <div>1️⃣ Explora el menú</div>
	              <div>2️⃣ Agrega al carrito</div>
	              <div>3️⃣ Confirma tu pedido</div>
	          </div>
	      </div>
	  </section>

	  <section class="py-20 bg-gray-50">
	      <h3 class="text-3xl font-bold text-center mb-10">Platos destacados</h3>
	      <p class="text-center text-gray-600">
	          Los favoritos de nuestros clientes
	      </p>
	  </section>

	  <section class="py-20 bg-white text-center">
	      <h3 class="text-3xl font-bold mb-6">Clientes felices</h3>
	      <p class="italic text-gray-600">“La mejor forma de pedir comida”</p>
	  </section>

	  <section class="py-20 bg-blue-600 text-white text-center">
	      <h3 class="text-4xl font-bold mb-6">
	          ¿Listo para ordenar?
	      </h3>

	      <a th:href="@{/register}"
	         class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold">
	          Crear cuenta
	      </a>
	  </section>

	  <section class="py-10 bg-gray-100 text-center text-sm text-gray-600">
	      Proyecto académico – Lenguaje de Programación II – 2026
	  </section>
	</div>
</html>