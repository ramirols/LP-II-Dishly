<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layout/main}">

<main layout:fragment="content">

	<!-- HERO SLIDER -->
	<section class="relative">
	  <div class="swiper heroSwiper h-[85vh]">

	    <div class="swiper-wrapper">

	      <!-- Slide 1 -->
	      <div
	        class="swiper-slide relative flex items-center justify-center text-center bg-cover bg-center"
	        style="background-image: url('/images/restaurant-1.jpg');"
	      >
	        <!-- Overlay --> 
	        <div class="absolute inset-0 bg-gradient-to-b from-[#010001]/60 via-[#010001]/50 to-[#010001]/70"></div>

	        <div class="relative z-10 max-w-3xl px-6">
	          <span class="inline-flex items-center gap-2 bg-blue-500/20 text-blue-300 px-4 py-1 rounded-full text-sm mb-6">
	            🍽️ Restaurante digital
	          </span>

	          <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
	            Ordena sin colas,<br />
	            directo desde tu mesa
	          </h1>

	          <p class="text-gray-200 max-w-xl mx-auto mb-8 text-lg">
	            Escanea el QR, explora el menú y realiza tu pedido sin esperar a un mozo.
	          </p>

	          <!-- Badges -->
	          <div class="flex flex-wrap justify-center gap-3 mb-8">
	            <span class="bg-white/10 text-white px-4 py-2 rounded-lg text-sm">
	              📱 100% móvil
	            </span>
	            <span class="bg-white/10 text-white px-4 py-2 rounded-lg text-sm">
	              ⚡ Pedido rápido
	            </span>
	            <span class="bg-white/10 text-white px-4 py-2 rounded-lg text-sm">
	              💳 Pago integrado
	            </span>
	          </div>

	          <button class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-xl font-semibold transition">
	            Ver cómo funciona
	          </button>
	        </div>
	      </div>

	      <!-- Slide 2 -->
	      <div
	        class="swiper-slide relative flex items-center justify-center text-center bg-cover bg-center"
	        style="background-image: url('/images/restaurant-2.jpg');"
	      >
	        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>

	        <div class="relative z-10 max-w-3xl px-6">
	          <span class="inline-flex items-center gap-2 bg-green-500/20 text-green-300 px-4 py-1 rounded-full text-sm mb-6">
	            ⚡ Rápido y simple
	          </span>

	          <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6">
	            Todo desde<br />tu celular
	          </h1>

	          <p class="text-gray-200 max-w-xl mx-auto mb-8 text-lg">
	            Categorías claras, platos destacados y carrito en tiempo real.
	          </p>

	          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-white">
	            <div class="bg-white/10 rounded-xl p-4">
	              📋 Menú digital
	            </div>
	            <div class="bg-white/10 rounded-xl p-4">
	              🛒 Carrito inteligente
	            </div>
	            <div class="bg-white/10 rounded-xl p-4">
	              🔔 Pedido en cocina
	            </div>
	          </div>
	        </div>
	      </div>

	      <!-- Slide 3 -->
	      <div
	        class="swiper-slide relative flex items-center justify-center text-center bg-cover bg-center"
	        style="background-image: url('/images/restaurant-3.jpg');"
	      >
	        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>

	        <div class="relative z-10 max-w-3xl px-6">
	          <span class="inline-flex items-center gap-2 bg-purple-500/20 text-purple-300 px-4 py-1 rounded-full text-sm mb-6">
	            📦 Flexible
	          </span>

	          <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6">
	            Delivery o<br />consumo en local
	          </h1>

	          <p class="text-gray-200 max-w-xl mx-auto mb-8 text-lg">
	            Tú decides cómo disfrutar tu pedido, sin fricciones.
	          </p>

	          <div class="flex justify-center gap-6 text-white">
	            <span class="bg-white/10 px-5 py-3 rounded-xl">
	              🏠 En mesa
	            </span>
	            <span class="bg-white/10 px-5 py-3 rounded-xl">
	              🛵 Delivery
	            </span>
	          </div>
	        </div>
	      </div>

	    </div>

	    <!-- Pagination -->
	    <div class="swiper-pagination"></div>
	  </div>
	</section>

	<!-- SECCION DE CATEGORIAS -->
	<section class="py-20 bg-gray-50">
	  <div class="container mx-auto">

	    <h2 class="text-3xl font-bold text-center mb-10">
	      Categorías del menú
	    </h2>

	    <div class="swiper categorySwiper">
	      <div class="swiper-wrapper">

	        <!-- th:each="categoria : ${categorias}" -->
	        <div class="swiper-slide">
	          <a href="#"
	             class="block bg-white p-6 rounded-xl shadow hover:shadow-lg transition text-center">
	            <h3 class="font-semibold text-lg mb-2">
	              Pastas
	            </h3>
	            <p class="text-sm text-gray-500">
	              Ver platos →
	            </p>
	          </a>
	        </div>

	      </div>
	    </div>

	  </div>
	</section>

  <!-- PLATOS DESTACADOS -->
  <section class="py-20 bg-white">
    <div class="container mx-auto">

      <h2 class="text-3xl font-bold text-center mb-4">
        Platos destacados
      </h2>

      <p class="text-center text-gray-600 mb-10">
        Los más pedidos por nuestros clientes
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">

        <!-- th:each="plato : ${destacados}" -->
        <div class="border rounded-xl overflow-hidden hover:shadow-lg transition">
          <img src="/images/demo.jpg" class="w-full h-48 object-cover">

          <div class="p-4">
            <h3 class="font-semibold text-lg mb-1">
              Lomo saltado
            </h3>

            <p class="text-gray-500 text-sm mb-2">
              Clásico peruano
            </p>

            <div class="flex justify-between items-center">
              <span class="font-bold text-blue-600">
                S/ 25.00
              </span>

              <a href="#" class="text-sm font-semibold text-blue-600">
                Ver →
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto text-center">

      <h2 class="text-3xl font-bold mb-10">
        ¿Cómo funciona?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <div class="bg-white p-6 rounded-xl shadow">
          <h3 class="font-bold mb-2">1️⃣ Explora</h3>
          <p class="text-gray-600">
            Navega por categorías y descubre platos.
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow">
          <h3 class="font-bold mb-2">2️⃣ Elige</h3>
          <p class="text-gray-600">
            Agrega tus favoritos al carrito.
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow">
          <h3 class="font-bold mb-2">3️⃣ Ordena</h3>
          <p class="text-gray-600">
            Confirma y sigue el estado de tu pedido.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="py-20 bg-white">
    <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <h3 class="font-bold text-xl">🚀 Rápido</h3>
        <p class="text-gray-600">Ordena sin esperas.</p>
      </div>
      <div>
        <h3 class="font-bold text-xl">📱 Digital</h3>
        <p class="text-gray-600">Todo desde tu celular.</p>
      </div>
      <div>
        <h3 class="font-bold text-xl">📦 Flexible</h3>
        <p class="text-gray-600">Delivery o consumo en local.</p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIO -->
  <section class="py-20 bg-gray-50 text-center">
    <h3 class="text-3xl font-bold mb-6">Clientes felices</h3>
    <p class="italic text-gray-600">
      “Pedir comida nunca fue tan fácil”
    </p>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-blue-600 text-white text-center">
    <h3 class="text-4xl font-bold mb-6">
      ¿Listo para ordenar?
    </h3>

    <a th:href="@{/register}"
       class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold">
      Crear cuenta
    </a>
  </section>
</main>
</html>