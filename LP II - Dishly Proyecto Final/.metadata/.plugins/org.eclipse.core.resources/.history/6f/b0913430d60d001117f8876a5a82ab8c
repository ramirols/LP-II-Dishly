<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layout/main}">

<main layout:fragment="content">

  <!-- HERO -->
  <section class="text-center py-24 bg-white">
    <span class="inline-block bg-blue-100 text-blue-600 px-4 py-1 rounded-full text-sm mb-4">
      🍽️ Restaurante digital
    </span>

    <h1 class="text-5xl font-bold mb-6">
      Ordena sin colas, directo desde tu mesa
    </h1>

    <p class="text-gray-600 max-w-xl mx-auto">
      Explora categorías, elige tus platos favoritos y realiza tu pedido
      de forma rápida y sencilla.
    </p>
  </section>

  <!-- CATEGORÍAS -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto">
      <h2 class="text-3xl font-bold text-center mb-10">
        Categorías del menú
      </h2>

      <!-- Swiper -->
      <div class="swiper">
        <div class="swiper-wrapper">
          <!-- th:each categoria -->
          <div class="swiper-slide text-center bg-white p-6 rounded-xl shadow">
            <a href="#">
              <h3 class="font-semibold text-lg">Pastas</h3>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PLATOS DESTACADOS -->
  <section class="py-20 bg-white">
    <div class="container mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4">
        Platos destacados
      </h2>

      <p class="text-center text-gray-600 mb-10">
        Los favoritos de nuestros clientes
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- th:each plato -->
        <div class="border rounded-xl p-4 hover:shadow-lg transition">
          <img src="/images/demo.jpg" class="rounded-lg mb-4" />
          <h3 class="font-semibold text-lg">Lomo saltado</h3>
          <p class="text-gray-600 text-sm mb-2">S/ 25.00</p>
          <a href="#" class="text-blue-600 font-semibold">
            Ver detalle →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto text-center">
      <h2 class="text-3xl font-bold mb-10">
        ¿Cómo funciona?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>🔎 Explora categorías</div>
        <div>🍽️ Elige tu plato</div>
        <div>✅ Confirma tu pedido</div>
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="py-20 bg-white">
    <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <h3 class="font-bold text-xl">🚀 Rápido</h3>
        <p class="text-gray-600">Ordena sin esperas.</p>
      </div>
      <div>
        <h3 class="font-bold text-xl">📱 Digital</h3>
        <p class="text-gray-600">Todo desde tu celular.</p>
      </div>
      <div>
        <h3 class="font-bold text-xl">📦 Flexible</h3>
        <p class="text-gray-600">Delivery o consumo en local.</p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIO -->
  <section class="py-20 bg-gray-50 text-center">
    <h3 class="text-3xl font-bold mb-6">Clientes felices</h3>
    <p class="italic text-gray-600">
      “Pedir comida nunca fue tan fácil”
    </p>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-blue-600 text-white text-center">
    <h3 class="text-4xl font-bold mb-6">
      ¿Listo para ordenar?
    </h3>

    <a th:href="@{/register}"
       class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold">
      Crear cuenta
    </a>
  </section>

  <!-- FOOTER -->
  <section class="py-6 bg-gray-100 text-center text-sm text-gray-600">
    Proyecto académico – Lenguaje de Programación II – 2026
  </section>

</main>
</html>